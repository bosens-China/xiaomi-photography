---
import { GithubOutlined, ExportOutlined } from '@ant-design/icons-vue';
import { homeUrl } from '@/lib/urls';
import '@/style.css';

const {
  title = '光影集 · 摄影周刊',
  description = '浏览摄影作品，学习光影与构图。',
  sourceUrl,
} = Astro.props;
const favicon = `${homeUrl}favicon.svg`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const dark = matchMedia('(prefers-color-scheme: dark)');
        let preference;
        try { preference = localStorage.getItem('gallery-theme'); } catch {}
        const apply = () => {
          const theme = preference === 'light' || preference === 'dark' ? preference : dark.matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = theme;
          const button = document.querySelector('.theme-control');
          if (!button) return;
          const next = theme === 'dark' ? '浅色模式' : '深色模式';
          button.setAttribute('aria-label', '切换至' + next);
          const sun = button.querySelector('.icon-sun');
          const moon = button.querySelector('.icon-moon');
          if (sun && moon) {
            sun.classList.toggle('hidden', theme !== 'dark');
            moon.classList.toggle('hidden', theme === 'dark');
          }
          const label = button.querySelector('.theme-label');
          if (label) label.textContent = next;
        };
        apply();
        dark.addEventListener('change', apply);
        document.addEventListener('DOMContentLoaded', () => {
          apply();
          document.querySelector('.theme-control')?.addEventListener('click', () => {
            preference = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
            try { localStorage.setItem('gallery-theme', preference); } catch {}
            apply();
          });
        });
      })();
    </script>
  </head>
  <body class="min-h-dvh flex flex-col bg-background text-foreground">
    <header class="site-header">
      <div class="shell header-inner flex items-center justify-between gap-4">
        <a
          class="inline-flex items-center gap-2.5 min-h-10 text-base font-semibold tracking-tight transition-opacity hover:opacity-85"
          href={homeUrl}
          aria-label="光影集首页"
        >
          <img src={favicon} width="26" height="26" alt="" class="rounded-md" />
          <span>光影集</span>
          <span class="hidden sm:inline-block text-xs font-normal text-muted-foreground border-l border-border pl-2.5 ml-0.5">
            摄影周刊
          </span>
        </a>
        <div class="flex items-center gap-2">
          <a
            class="control"
            href="https://github.com/bosens-China/xiaomi-photography"
            target="_blank"
            rel="noopener"
            aria-label="GitHub 仓库"
          >
            <GithubOutlined aria-hidden="true" />
            <span class="hidden sm:inline">GitHub</span>
          </a>
          <button
            class="control theme-control"
            type="button"
            aria-label="切换主题"
          >
            <svg
              class="icon-sun hidden w-4 h-4 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
            </svg>
            <svg
              class="icon-moon w-4 h-4 shrink-0"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
            </svg>
            <span class="theme-label hidden sm:inline">主题</span>
          </button>
        </div>
      </div>
    </header>
    <div class="flex-1">
      <slot />
    </div>
    <footer class="mt-16 border-t border-border text-muted-foreground text-xs">
      <div class="shell min-h-16 py-4 flex flex-wrap items-center justify-between gap-3">
        <span class=" tracking-wide">光影集 · 极简摄影构图周刊</span>
        {sourceUrl && (
          <a
            class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-foreground transition-colors underline underline-offset-4"
            href={sourceUrl}
            target="_blank"
            rel="noopener"
          >
            <span>查看本期作品来源</span>
            <ExportOutlined aria-hidden="true" class="text-[11px]" />
          </a>
        )}
      </div>
    </footer>
  </body>
</html>
