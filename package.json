{
  "name": "xiaomi-photography",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "astro dev --base /",
    "build": "astro check && vue-tsc --noEmit && astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "sync:issues": "node --experimental-strip-types scripts/sync-issues.ts",
    "check:scripts": "tsc --noEmit --strict --target ES2022 --module NodeNext --skipLibCheck --allowImportingTsExtensions scripts/*.ts"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@astrojs/vue": "^6.0.1",
    "@vueuse/core": "^13.0.0",
    "astro": "^6.4.8",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.22.0",
    "@unocss/astro": "^66.13.0",
    "eslint": "^9.22.0",
    "eslint-plugin-check-file": "^3.1.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.27.0",
    "unocss": "^66.13.0",
    "vue-tsc": "^2.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
